# Environment variables for Docker deployment
# Copy this file to .env and fill in your values

# ============================================
# LLM Configuration
# ============================================
# Provider: minimax (default; other providers are explicit opt-in)
LLM_PROVIDER=minimax

# MiniMax Configuration (Default)
MINIMAX_API_KEY=your_minimax_api_key_here
MINIMAX_API_BASE=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M2.7-highspeed
LLM_MODEL=MiniMax-M2.7-highspeed
MAX_TOKENS=32768
L1_MAX_TOKENS=32768
L1_LLM_MAX_CONCURRENT=8
L1_TRANSIENT_RETRIES=1
LLM_INCOMPLETE_OUTPUT_MAX_TOKENS=65536

# LLM concurrency and graph fan-out budgets. Start at the measured baseline
# and increase only after observing provider 429/5xx rates and p95 latency.
LLM_MAX_CONCURRENT=12
GRAPH_MAX_CONCURRENCY=12
L2_LLM_MAX_CONCURRENT=12
L3_LLM_MAX_CONCURRENT=8
LLM_PROVIDER_MAX_RETRIES=0
LLM_PROVIDER_CIRCUIT_FAILURE_THRESHOLD=3
LLM_REASONING_EFFORT=low
LLM_PROVIDER_REQUEST_TIMEOUT=600
LLM_STREAM_TIMEOUT=900
L1_LLM_TIMEOUT_S=480
DIMENSION_EXECUTION_TIMEOUT_S=1200
LAYER_TIMEOUT_S=1800
GROUND_ANCHOR_TIMEOUT_S=180
GROUND_LLM_CALL_TIMEOUT_S=30
GROUND_MAX_LLM_CALLS=8
GROUND_LLM_MAX_CONCURRENT=4
# Real semantic grounding is explicit opt-in. Keep both false in tests/dev.
GROUND_LLM_ENABLED=false
SOURCE_SEMANTIC_LLM_ENABLED=false
# External evidence in L1/L2/L3 planning prompts is quota-sensitive and opt-in.
EVIDENCE_EXTERNAL_FOR_LLM=false
# MiniMax-M2.x needs enough completion budget to finish the typed query spec.
GROUND_QUERY_SPEC_MAX_TOKENS=1200
L3_PROVIDER_PARSE_RETRIES=0
L3_STRUCTURAL_COMPILE_RETRIES=0
L3_SEMANTIC_COMPILE_RETRIES=1
REAL_RUN_DEADLINE_SECONDS=7200

# Alternative: OpenAI
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_API_BASE=  # Leave empty for official OpenAI API
# LLM_MODEL=gpt-4o

# Alternative: ZhipuAI (GLM)
# LLM_PROVIDER=zhipuai
# ZHIPUAI_API_KEY=your_zhipuai_api_key_here
# LLM_MODEL=glm-4-flash

# Alternative: DeepSeek/OpenAI-compatible API
# LLM_PROVIDER=deepseek
# OPENAI_API_KEY=your_deepseek_api_key_here
# OPENAI_API_BASE=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# Alternative: OpenCode Go (OpenAI-compatible Chat Completions)
# LLM_PROVIDER=opencode-go
# OPENCODE_GO_API_KEY=your_opencode_go_api_key_here
# OPENCODE_GO_API_BASE=https://opencode.ai/zen/go/v1
# OPENCODE_GO_MODEL=deepseek-v4-flash

# ============================================
# Embedding Model Configuration
# ============================================
# Embedding Provider: local (HuggingFace) 或 aliyun (阿里云 DashScope API)
# 推荐: aliyun (无需本地模型，内存占用低，适合低配服务器)
EMBEDDING_PROVIDER=aliyun

# ============================================
# 本地模型配置 (EMBEDDING_PROVIDER=local)
# ============================================
# Chinese embedding model for RAG knowledge base
# 注意: 本地模型加载需要约 1-2GB 内存
# EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5
# EMBEDDING_DEVICE=cpu

# HuggingFace mirror (auto-used when model not cached)
# Default: https://hf-mirror.com (Alibaba Cloud mirror, fast in China)
# HF_ENDPOINT=https://hf-mirror.com

# Force offline/online mode (usually not needed, auto-detected)
# Set HF_HUB_OFFLINE=1 to force offline (fail if model not cached)
# Set HF_HUB_OFFLINE=0 to force online (always check for updates)
# HF_HUB_OFFLINE=
# TRANSFORMERS_OFFLINE=

# ============================================
# 阿里云 DashScope Embedding API (EMBEDDING_PROVIDER=aliyun)
# ============================================
# 文档: https://help.aliyun.com/zh/model-studio/text-embedding-synchronous-api
# 支持的模型: text-embedding-v4 (推荐), text-embedding-v3, text-embedding-v2
# text-embedding-v4 支持可变维度: 2048/1536/1024/768/512/256/128/64
# 内存占用: 极低 (API 调用，无需本地模型)
DASHSCOPE_API_KEY=your_dashscope_api_key
ALIYUN_EMBEDDING_MODEL=text-embedding-v4
# EMBEDDING_DIMENSIONS=1024

# ============================================
# Multimodal (Vision) Configuration
# ============================================
# Enable multimodal support for image analysis in planning workflow
# When enabled, uploaded images will be sent to vision-capable LLM
MULTIMODAL_ENABLED=true

# Multimodal model - use the active provider's OpenAI-compatible interface
# The default follows the primary MiniMax high-speed model. Override this only
# when the selected provider requires a dedicated vision-capable model.
MULTIMODAL_MODEL=MiniMax-M2.7-highspeed

# Image detail level for OpenAI API: low, high, or auto
IMAGE_DETAIL_LEVEL=auto

# Max image size for multimodal processing (bytes)
MAX_IMAGE_SIZE_MULTIMODAL=10000000

# ============================================
# DashScope Multimodal Setup (Recommended)
# ============================================
# To use DashScope for multimodal, configure:
# OPENAI_API_KEY=<your_dashscope_api_key>
# OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# MULTIMODAL_MODEL=MiniMax-M2.7-highspeed
#
# Note: This uses OpenAI-compatible interface, no new provider needed

# ============================================
# Backend Configuration
# ============================================
ENVIRONMENT=production
USE_ASYNC_DATABASE=true

# Port configuration (optional, defaults shown)
# BACKEND_PORT=8000
# FRONTEND_PORT=3000

# CORS allowed origins (comma-separated)
# IMPORTANT: Add your public frontend URL for production deployment
# Example: http://localhost:3000,http://your-server-ip:3000,https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:3000

# ============================================
# Frontend Configuration (IMPORTANT for Production)
# ============================================
# This URL must be accessible from the browser (NOT Docker internal network)
# 
# For local testing:
#   NEXT_PUBLIC_API_URL=http://localhost:8000
#
# For production deployment:
#   NEXT_PUBLIC_API_URL=http://YOUR_SERVER_IP:8000
#   OR
#   NEXT_PUBLIC_API_URL=https://api.yourdomain.com (if using reverse proxy)
#
NEXT_PUBLIC_API_URL=http://localhost:8000

# ============================================
# Production Deployment Guide
# ============================================
# 
# 1. Copy this file to .env:
#    cp .env.example .env
#
# 2. Edit .env with your configuration:
#    - Set ZHIPUAI_API_KEY to your API key
#    - Set NEXT_PUBLIC_API_URL to your server's public address
#    - Set ALLOWED_ORIGINS to include your frontend's public address
#
# 3. Deploy with Docker Compose:
#    docker-compose up -d
#

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000

# GIS Tile Source Configuration
# Available options: tianditu, geoq, openstreetmap
# NOTE: tianditu requires TIANDITU_API_KEY in the backend .env.
# Switching to osm as a free fallback so the base map renders immediately.
NEXT_PUBLIC_TILE_SOURCE=openstreetmap
